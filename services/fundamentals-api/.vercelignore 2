# Vercel's Python builder prefers pyproject.toml over requirements.txt when
# both are present in the uploaded source — but pyproject.toml declares the
# full local-dev dependency set (scrapling[fetchers], camelot, opencv,
# polars, alembic), which is both far too heavy for a serverless function
# and pulls in Playwright transitively (see ADR 0013, requirements.txt's
# own header comment). Excluding it here forces the deployed build onto the
# trimmed requirements.txt instead, without touching local dev at all.
pyproject.toml

# Not needed at runtime — migrations run out-of-band, tests don't ship.
alembic.ini
migrations/
tests/
.venv/
.pytest_cache/
.ruff_cache/
