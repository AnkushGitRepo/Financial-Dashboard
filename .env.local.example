# Copy to .env.local and fill in real values. .env.local is gitignored.

# Deployment mode: "hosted" or "selfhost". Defaults to "selfhost" when unset —
# a fresh clone with no config just runs with no login screen and no billing
# UI (single local user, straight into the dashboard). Only set this to
# "hosted" for MarketMitra's own paid deployment, where it turns on Clerk auth
# and the pricing/billing UI. Self-hosted users can leave this unset entirely.
# See ADR 0010.
NEXT_PUBLIC_DEPLOYMENT_MODE=selfhost

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB=marketmitra

# Fundamentals data service (services/fundamentals-api, ADR 0011). Run it
# locally with `uvicorn app.main:app --port 8420` from that directory.
FUNDAMENTALS_API_URL=http://localhost:8420

# Alerts (Phase 5, ADR 0014)
# CRON_SECRET guards POST /api/cron/evaluate-alerts. Vercel Cron sends it as a
# bearer token automatically once set; self-hosters pass it themselves. When
# unset, the route runs in dev but is refused (503) in production.
CRON_SECRET=
# Optional external delivery — in-app notifications always work without this.
# ALERT_WEBHOOK_URL: a single URL every triggered alert is POSTed to
# (Telegram/Discord/Slack incoming webhooks work).
# (Email delivery is a config-gated seam not yet wired to a provider — see
# ROADMAP.md "Phase 5 follow-ups". ALERT_EMAIL_TO is reserved for it.)
ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=

# Clerk (https://dashboard.clerk.com) — only required when DEPLOYMENT_MODE=hosted
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
